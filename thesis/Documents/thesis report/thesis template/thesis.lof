\contentsline {figure}{\numberline {3.1}{\ignorespaces Proportion of missing values in the raw dataset.}}{17}{figure.caption.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Representative per-column marginal distributions, real versus all five synthetic generators. HealthGAN and the three Pythia variants track the real reference; PATE-GAN places mass on invalid category codes and distorts both the categorical and the continuous marginals.}}{47}{figure.caption.51}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Correlation-difference heatmaps (real minus synthetic) for the worst and best generators on the joint-dependency axis. Saturated cells denote large residual correlation; pale cells denote faithful reproduction.}}{49}{figure.caption.55}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Two-dimensional PCA projection (onto the principal components of the real data) of real and synthetic records. Four generators overlap the real cloud; PATE-GAN is displaced into a disjoint region along the first principal component.}}{50}{figure.caption.57}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Gradient-Boosting ROC curves under TSTR for all five generators and the real (TRTR) reference. Legend values are the corresponding AUC-ROC scores.}}{52}{figure.caption.62}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Feature-importance agreement with the real-trained random-forest reference. Scores are based on the $L_1$ distance between normalised importance vectors; higher values indicate closer agreement.}}{53}{figure.caption.64}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Consolidated privacy diagnostics across the five generators: synthetic-to-real nearest-neighbour distance (top left), membership-inference AUC against the random-guess baseline (top right), attribute-inference advantage per attribute (bottom left), and outlier versus non-outlier linkability (bottom right).}}{58}{figure.caption.73}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Privacy--utility landscape across the five generators. Horizontal axis: predictive utility (Gradient-Boosting TSTR AUC-ROC); vertical axis: privacy (median NNDR, where values above $1.0$ indicate that the median synthetic-to-real distance is not below the real-to-real reference scale). PATE-GAN sits far above the plane because its off-manifold output inflates the distance ratio; it is included for landscape completeness and interpreted as the GAN family's DP-enforced operating point (\S \ref {sec:discussion:limit:pategan-dual-role}).}}{60}{figure.caption.75}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Utility Radar Comparison across six min--max scaled utility axes: AUC-ROC, F1, $1-$KS, $1-$CorrDiff, Cox confidence-interval overlap, and feature-importance agreement. Larger radius indicates stronger relative utility on the plotted axis.}}{61}{figure.caption.76}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Utility--privacy heatmap across the five generators. Utility metrics are oriented as performance and privacy metrics as risk, each min--max scaled to $[0,1]$ across the generators. Only the leakage side of the middle-ideal privacy metrics is counted, so a distributionally collapsed generator can appear low-risk in the privacy block and must be read together with the summary table of Table~\ref {tab:rq2:summary}.}}{62}{figure.caption.77}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Within-family differential-privacy transitions on the privacy--utility plane. Each arrow runs from the non-private to the differentially private variant of one family: HealthGAN $\to $ PATE-GAN (GAN family) and Pythia-1B $\to $ Pythia-1B-DP (LLM family). The vertical axis is logarithmic; PATE-GAN's high NNDR is the off-manifold artefact of Section~\ref {sec:results:rq2:privacy:nn}.}}{67}{figure.caption.81}%

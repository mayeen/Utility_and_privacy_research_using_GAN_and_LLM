\contentsline {figure}{\numberline {3.1}{\ignorespaces Proportion of missing values in the raw dataset.}}{17}{figure.caption.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Representative per-column marginal distributions, real versus all five synthetic generators. HealthGAN and the three Pythia variants track the real reference; PATE-GAN places mass on invalid category codes and distorts both the categorical and the continuous marginals.}}{46}{figure.caption.50}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Correlation-difference heatmaps (real minus synthetic) for the worst and best generators on the joint-dependency axis. Saturated cells denote large residual correlation; pale cells denote faithful reproduction.}}{48}{figure.caption.54}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Two-dimensional PCA projection (onto the principal components of the real data) of real and synthetic records. Four generators overlap the real cloud; PATE-GAN is displaced into a disjoint region along the first principal component.}}{49}{figure.caption.56}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Gradient-Boosting ROC curves under TSTR for all five generators and the real (TRTR) reference. Legend values are the corresponding AUC-ROC scores.}}{51}{figure.caption.61}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Random-forest feature importances, real versus synthetic. The four faithful generators preserve the real top-ranked predictors; PATE-GAN shifts importance onto sparsely populated indicators.}}{52}{figure.caption.63}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Cox hazard-ratio estimates with $95\%$ confidence intervals, real (black) versus synthetic (colour). Shaded rows mark covariates whose intervals do not overlap. PATE-GAN disagrees on every covariate; Pythia-1B recovers the majority. The hazard-ratio plots for the remaining three generators appear in Appendix~\ref {app:cox}.}}{53}{figure.caption.66}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Consolidated privacy view across the five generators: synthetic -to-real nearest-neighbour distance (top left), membership-inference AUC against the random-guess baseline (top right), attribute-inference advantage per attribute (bottom left), and outlier versus non-outlier linkability (bottom right).}}{58}{figure.caption.76}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Privacy--utility landscape across the five generators. Horizontal axis: predictive utility (Gradient-Boosting TSTR AUC-ROC); vertical axis: privacy (median NNDR, where values above $1.0$ indicate no proximity-based disclosure). PATE-GAN sits far above the plane because its off-manifold output inflates the distance ratio; it is included for landscape completeness and interpreted as the GAN family's DP-enforced operating point (\S \ref {sec:discussion:limit:pategan-dual-role}).}}{59}{figure.caption.77}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Radar comparison of the five generators across two fidelity axes (fidelity as $1-$KS, correlation preservation), two predictive axes (TSTR AUC-ROC, Cox CI overlap), and a composite privacy axis. Larger radius is better on every axis.}}{60}{figure.caption.78}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Within-family differential-privacy transitions on the privacy--utility plane. Each arrow runs from the non-private to the differentially private variant of one family: HealthGAN $\to $ PATE-GAN (GAN family) and Pythia-1B $\to $ Pythia-1B-DP (LLM family). The vertical axis is logarithmic; PATE-GAN's high NNDR is the off-manifold artefact of Section~\ref {sec:results:rq2:privacy:nn}.}}{65}{figure.caption.83}%
